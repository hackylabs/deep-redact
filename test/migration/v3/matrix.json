        "instantiation": "new DeepRedact({ blacklistedKeys: ['password', 'token'], replacement: '[REDACTED]' })",
        "invocation": "redactor.redact(payload)"
      },
      "v4Usage": {
        "import": "deepRedact",
        "factory": "deepRedact({ keys: ['password', 'token'], censor: '[REDACTED]' })",
        "invocation": "redactor(payload)",
        "config": {
          "keys": ["password", "token"],
          "censor": "[REDACTED]"
        }
      },
      "migrationSteps": [
        "Replace `new DeepRedact(options)` with `deepRedact(options)`.",
        "Replace `redactor.redact(payload)` with `redactor(payload)`.",
        "Rename `blacklistedKeys` to `keys`.",
        "Rename `replacement` to `censor`."
      ],
      "assertionMode": "v4-structured-output",
      "expectedResult": {
        "kind": "structured",
        "file": "expected-v4.json"
      }
    },
